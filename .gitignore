# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated testnet artifacts (`pneumatic_testnet_gen`). These directories hold
# node keystores — `node_identity.json` contains Ed25519 seeds and ML-DSA/ML-KEM
# secret keys — so they must never be committed, even though the testnet they
# describe is throwaway.
deploy/generated/

# Local test-run output. These three files were tracked before anyone thought
# about it, so every `cargo test` dirtied the working tree and buried real
# changes in log churn. Unanchored on purpose: `test.log` also covers
# `committer/test.log`, since a test binary writes one wherever it is invoked.
test.log
test_log.txt
